# Copy to .env.local and fill in. Never commit .env.local.

# Base URL of the backend API project (gazellkey-client/gazellkey-international)
API_URL="http://localhost:3100"

# Stripe dashboard, for the "View in Stripe" links on the Payments page.
# Keep /test while using test keys; remove it ("https://dashboard.stripe.com") when live.
STRIPE_DASHBOARD_URL="https://dashboard.stripe.com/test"
